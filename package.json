{
  "name": "ai-native-playwright-orchestration",
  "version": "1.0.0",
  "description": "AI-Native Playwright orchestration: CLAUDE.md orchestrator + Constitution + Agent Skills over a disciplined Playwright/TypeScript scaffold. App under test: The Testing Academy practice apps.",
  "author": "Pramod Dutta (The Testing Academy)",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:e2e": "playwright test --grep @e2e",
    "test:api": "playwright test --grep @api",
    "test:functional": "playwright test --grep @functional",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "verify:governance": "node scripts/verify-governance.mjs"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.0.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "zod": "^4.0.0"
  }
}